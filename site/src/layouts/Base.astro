---
import { LOCALES, visibleLocales, type LocaleCode } from '../i18n/locales';
import { t } from '../lib/i18n';
import '../styles/global.css';
// One stylesheet per engine (src/styles/engines/<engine>.css); new engines need no edit here.
import.meta.glob('../styles/engines/*.css', { eager: true });

interface Props { locale: LocaleCode; title?: string }
const { locale, title } = Astro.props;
const meta = LOCALES[locale];
const pageTitle = title ? `${title} · ${t('site.name', locale)}` : t('site.name', locale);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{pageTitle}</title>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="stylesheet" href={`${base}katex.min.css`} />
    <link rel="preload" href={`${base}fonts/Vazirmatn-Regular.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {meta.status === 'draft' && <p class="draft-banner" role="status">{t('draft.banner', locale)}</p>}
    <header class="site-header">
      <a class="brand" href={`${base}${locale}/`}>{t('site.name', locale)}</a>
      <nav aria-label={t('nav.language', locale)} class="lang-switch">
        {visibleLocales().map((code) => (
          <a href={`${base}${code}/`} lang={LOCALES[code].htmlLang} aria-current={code === locale ? 'page' : undefined}>
            {LOCALES[code].nativeName}
          </a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <script is:inline define:vars={{ swUrl: `${base}sw.js`, locale }}>
      // Not on file:// (offline zip bundles): service workers need http(s).
      if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
        navigator.serviceWorker.register(swUrl);
        // Once active, ask it to download this locale's whole site for offline use.
        navigator.serviceWorker.ready.then((reg) => reg.active && reg.active.postMessage({ type: 'precache', locale }));
      }
    </script>
  </body>
</html>
